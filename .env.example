# Copy this file to .env and fill in real values. NEVER commit .env

APP_ENV=local
LOG_LEVEL=INFO

# ---- Database (must match docker-compose.yml) ----
POSTGRES_USER=placement
POSTGRES_PASSWORD=placement
POSTGRES_DB=placement_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://placement:placement@localhost:5432/placement_assistant

# ---- AI: Phase 6. Leave blank until then ----
ANTHROPIC_API_KEY=

# ---- Telegram read-only source: Phase 4. Leave blank until then ----
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000